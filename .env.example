# Copy to .env and fill in your values (do not commit .env)

# PostgreSQL — use Railway's DATABASE_URL from your project Variables
# For Railway web service: use the variable Railway injects when Postgres is linked
# For local dev with Railway Postgres: use the PUBLIC proxy URL (not *.railway.internal)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:PORT/railway

# WhatsApp bridge (optional — enabled by default on Railway Docker deploy)
WHATSAPP_ENABLED=1
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
# Mount a Railway volume at this path so you only scan QR once:
# WHATSAPP_AUTH_DIR=/app/whatsapp-bridge/.wwebjs_auth
