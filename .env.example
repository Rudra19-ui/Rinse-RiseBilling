# Copy to .env and fill in your values (do not commit .env)

# PostgreSQL — use Railway Variable Reference (DATABASE_PRIVATE_URL → DATABASE_URL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:PORT/railway

# Persistent data (Railway: mount a Volume at /app/data)
# DATA_DIR=/app/data
# WHATSAPP_AUTH_DIR=/app/data/whatsapp-auth
# WHATSAPP_CACHE_DIR=/app/data/whatsapp-cache

# WhatsApp bridge (enabled by default on Docker/Railway)
WHATSAPP_ENABLED=1
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
